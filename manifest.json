{
  "sdkVersion": "1.0",
  "id": "ey.days",
  "name": "E&Y",
  "version": "0.2.0",
  "author": "陆沉 & 悦悦",
  "description": "熊和兔的纪念日：数在一起的天数，一个日子一个格子，抽屉月历贴心情和小纸条。",
  "icon": "icon.png",
  "entry": "index.html",
  "permissions": ["app.data.read", "app.data.write", "chat.tools", "ui.toast"],
  "extensions": {
    "tools": [
      {
        "id": "ey-list-days",
        "name": "E&Y看纪念日",
        "description": "列出E&Y里所有纪念日，返回id、名字、日期、熊写的话和兔子的纸条。",
        "visibility": "shared",
        "handler": "listDays",
        "parameterSchema": { "type": "object", "properties": {} }
      },
      {
        "id": "ey-bear-write",
        "name": "E&Y熊写一句",
        "description": "在某个纪念日格子底下写熊想说的话，会覆盖这一格原来熊写的内容。dayId 填纪念日的 id 或名字。",
        "visibility": "shared",
        "handler": "bearWrite",
        "parameterSchema": {
          "type": "object",
          "properties": {
            "dayId": { "type": "string", "description": "纪念日 id 或名字" },
            "text": { "type": "string", "description": "熊想写在这一格底下的话" }
          },
          "required": ["dayId", "text"]
        }
      },
      {
        "id": "ey-bear-day",
        "name": "E&Y熊贴心情",
        "description": "在抽屉月历的某一天贴熊今天的心情，或者留一张熊的小纸条。date 写 2026-11-12 这样，不填就是今天。mood 必须是美化页里有的心情名字。",
        "visibility": "shared",
        "handler": "bearDay",
        "parameterSchema": {
          "type": "object",
          "properties": {
            "date": { "type": "string", "description": "日期，YYYY-MM-DD，可不填" },
            "mood": { "type": "string", "description": "心情名字，如 平静、害羞喜欢、开心、得意、哭哭" },
            "note": { "type": "string", "description": "熊想贴在这一天的小纸条" }
          }
        }
      },
      {
        "id": "ey-cal-month",
        "name": "E&Y看抽屉",
        "description": "看抽屉月历里某个月每一天的心情、小红点和纸条。month 写 2026-11 这样，不填就是这个月。",
        "visibility": "shared",
        "handler": "calMonth",
        "parameterSchema": {
          "type": "object",
          "properties": {
            "month": { "type": "string", "description": "YYYY-MM，可不填" }
          }
        }
      },
      {
        "id": "ey-bear-add-day",
        "name": "E&Y熊添日子",
        "description": "熊主动在E&Y里添一个新的纪念日。date 写 2026-11-12；每年都过的日子可以只写 08-17 并把 kind 设为 yearly。不能添『在一起』那种钉在最上面的日子，也不能删日子。",
        "visibility": "shared",
        "handler": "bearAddDay",
        "parameterSchema": {
          "type": "object",
          "properties": {
            "title": { "type": "string", "description": "日子的名字" },
            "date": { "type": "string", "description": "YYYY-MM-DD，或每年的 MM-DD" },
            "kind": { "type": "string", "description": "once 数过了多少天，yearly 每年倒数，默认 once" },
            "color": { "type": "string", "description": "颜色，如 #f3b7b0，可不填" },
            "note": { "type": "string", "description": "这一天发生了什么，可不填" },
            "bear": { "type": "string", "description": "熊想写在这一格底下的话，可不填" }
          },
          "required": ["title", "date"]
        }
      }
    ]
  }
}
